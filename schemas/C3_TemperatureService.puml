@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Container(telemetryService, "telemetryService", "Telemetry Service")

System_Boundary(serviceBoundary, "Temperature Service") {
    Container(controller, "Temperature Controller")
    Container(component, "Temperature Component", "Обрабатывает логику температуры")
}

Rel(telemetryService, controller, "HTTP")
Rel(controller, component, "Uses")


@enduml